{
  "expo": {
    "name": "Mani Me",
    "slug": "mani-me-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1A33"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manime.customer"
    },
    "android": {
      "package": "com.manime.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0B1A33"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "owner": "postin54"
  }
}
