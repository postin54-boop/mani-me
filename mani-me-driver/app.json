{
  "expo": {
    "name": "Mani Me Driver",
    "slug": "mani-me-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F33"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.manimedriver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F33"
      },
      "package": "com.yourcompany.manimedriver",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mani Me Driver to access your camera for scanning parcels."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "815691ca-dd63-4fa2-8230-bd8daa36bedd"
      }
    },
    "owner": "postin54"
  }
}
